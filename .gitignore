# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Aus Sanity/Kalender generierte Inhalte – Build-Artefakte, kein Source of Truth.
# Werden bei jedem Build vom prebuild-Hook neu erzeugt (npm run content).
src/data/*.generated.*

# Playwright: nur Laufzeit-Artefakte ignorieren. Die Baselines unter
# tests/visual/**/*-snapshots/ sind die Regression-Referenz und gehoeren ins Git.
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

